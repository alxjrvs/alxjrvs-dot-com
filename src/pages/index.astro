---
import carouselSrc from "../client/carousel.ts?inline-script";
import gridSrc from "../client/grid.ts?inline-script";
import recedeSrc from "../client/recede.ts?inline-script";
import snapSrc from "../client/snap.ts?inline-script";
import Die from "../components/Die.astro";
import Footer from "../components/Footer.astro";
import InlineScript from "../components/InlineScript.astro";
import PostList from "../components/PostList.astro";
import Prose from "../components/Prose.astro";
import Base from "../layouts/Base.astro";
import { env } from "cloudflare:workers";
import { site } from "../site";
import { fetchCampaigns, type Campaign } from "../lib/kith";
import { getFrontPage, getPlaces, getProjects, getRolls, getSection } from "../lib/content";

const [projects, posts, rolls, projectsHead, writingHead, about, places, campaignsHead, campaigns] = await Promise.all([
  getProjects(Astro),
  // every piece, where a new reader can start listed first
  getFrontPage(Astro),
  getRolls(Astro),
  getSection(Astro, "projects"),
  getSection(Astro, "writing"),
  getSection(Astro, "about"),
  getPlaces(Astro),
  getSection(Astro, "campaigns"),
  // the tables on Kith.town: running, or signing up (src/lib/kith.ts)
  fetchCampaigns(env.KITH as Parameters<typeof fetchCampaigns>[0]),
]);
// "Signing up", or when it next plays: "Next game Nov 27"
const day = (d: Date) => d.toLocaleDateString("en-US", { timeZone: site.timezone, month: "short", day: "numeric" });
// the cards wear Kith.town's colour, from its project card
const kithAccent = projects.find((p) => p.link.startsWith("https://kith.town"))?.accent_dark ?? "currentColor";
const status = (c: Campaign) => (c.open ? "Signing up" : c.next ? `Next game ${day(c.next)}` : "Running");
const { subjects, objects, lead, likes, likesLead } = rolls;
// the projects, for search engines: an ItemList on the profile page
const ld = {
  hasPart: {
    "@type": "ItemList",
    name: projectsHead?.title ?? "Projects",
    itemListElement: projects.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.title, url: p.link, description: p.summary })),
  },
};
---
<Base ld={ld}>
<section class="screen intro" aria-label="Introduction">
  <Die class="die-corner" />
  <h1 class="mark" id="mark" aria-label="alex jarvis"><span class="alx">al<span class="ghost">e</span>x</span><span class="ghost">&nbsp;</span><span class="jrvs">j<span class="ghost">a</span>rv<span class="ghost">i</span>s</span></h1>
  <p class="tagline" id="tagline"><span class="tag-a"><span class="roll roll-subject" data-suffix=".">{subjects[0]}.</span></span> <span class="tag-b">{lead} <em class="roll roll-object" data-suffix=".">{objects[0]}.</em></span></p>
  <a class="scroll-cue" href="#projects" aria-label="Scroll down to projects"><span class="scroll-cue-label" aria-hidden="true">Scroll down</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg></a>
</section>

<section class="screen wrap" id="projects" aria-labelledby="projects-head" aria-roledescription="carousel">
  <h2 id="projects-head">{projectsHead?.title}</h2>
  <div class="carousel">
  <div class="cards" id="cards">
    {projects.map((p, i) => {
      const shot = p.shot && `/assets/work/${p.shot}`;
      return (
        <article class="card" style={`--accent:${p.accent_dark}`} aria-roledescription="slide" aria-label={`${i + 1} of ${projects.length}: ${p.title}`}>
          {shot && <a class="shot" href={p.link} tabindex="-1" aria-hidden="true"><img src={`${shot}.webp`} srcset={`${shot}-640.webp 640w, ${shot}.webp 1280w`} sizes="(max-width: 760px) 84vw, 60vw" alt="" width="1280" height="800" loading="lazy" fetchpriority="low" decoding="async"></a>}
          <div class="card-body">
            <h3>{p.title}</h3>
            <p class="summary">{p.summary}</p>
            {p.built && <p class="built label">{p.built}</p>}
            <p class="card-links">
              <a class="visit" href={p.link}>Visit {p.link_label ?? p.title} <span aria-hidden="true">↗</span></a>
              {p.source && <a class="source" href={p.source} aria-label={`Source: ${p.title} on GitHub`}>Source <span aria-hidden="true">↗</span></a>}
            </p>
          </div>
        </article>
      );
    })}
  </div>
  <button class="nudge next" type="button" aria-label="Next project" aria-controls="cards"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6"/></svg></button>
  <button class="hold" type="button" aria-pressed="false" aria-controls="cards" aria-label="Hold the slideshow" title="Hold the slideshow" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7v10M15 7v10"/></svg></button>
  </div>
</section>

{/* Campaigns: the tables running or signing up on Kith.town. Only there
    once its section is written in EmDash and Kith has something to show. */}
{campaignsHead && campaigns.length > 0 && (
  <section class="screen wrap" id="campaigns" aria-labelledby="campaigns-head" aria-roledescription="carousel">
    <h2 id="campaigns-head">{campaignsHead.title}</h2>
    <div class="carousel">
    <div class="cards" id="campaign-cards">
      {campaigns.map((c, i) => (
        <article class="card campaign" style={`--accent:${kithAccent}`} aria-roledescription="slide" aria-label={`${i + 1} of ${campaigns.length}: ${c.name}`}>
          {c.image && <a class="shot" href={c.url} tabindex="-1" aria-hidden="true"><img src={c.image} alt="" width="1200" height="630" loading="lazy" fetchpriority="low" decoding="async"></a>}
          <div class="card-body">
            <h3>{c.name}</h3>
            {c.tagline && <p class="summary">{c.tagline}</p>}
            <p class="built label">{[c.system, status(c)].filter(Boolean).join(" · ")}</p>
            <p class="card-links">
              <a class="visit" href={c.url}>{campaignsHead.dek ?? "Visit"} <span aria-hidden="true">↗</span></a>
            </p>
          </div>
        </article>
      ))}
    </div>
    {campaigns.length > 1 && <button class="nudge next" type="button" aria-label="Next campaign" aria-controls="campaign-cards"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6"/></svg></button>}
    {campaigns.length > 1 && <button class="hold" type="button" aria-pressed="false" aria-controls="campaign-cards" aria-label="Hold the slideshow" title="Hold the slideshow" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7v10M15 7v10"/></svg></button>}
    </div>
  </section>
)}

{/* Writing only exists on the page (and in the nav) once there's some. */}
{posts.length > 0 && (
  <section class="screen wrap" id="writing" aria-labelledby="writing-head">
    <div class="section-head">
      <h2 id="writing-head">{writingHead?.title}</h2>
    </div>
    <PostList posts={posts.slice(0, 5)} projects={projects} places={places} />
    {/* Every piece, for the die to draw from when it rolls this list. */}
    {posts.length > 1 && <template id="writing-pool"><PostList posts={posts} projects={projects} places={places} /></template>}
    {writingHead?.dek && <a class="all-writing" href="/writing/">{writingHead.dek} <span aria-hidden="true">→</span></a>}
  </section>
)}

<section class="screen wrap about" id="about" aria-labelledby="about-head">
  <div class="about-body">
    <h2 id="about-head">{about?.title}</h2>
    <div class="bio">
      {about && <Prose value={about.body} />}
      <p class="likes">{likesLead} <span id="likes"><span class="like">{likes[0][0]}</span>, <span class="like">{likes[1][0]}</span>, and <span class="like">{likes[2][0]}</span></span>.</p>
      {/* how to reach me, in the bio and not only the footer; the section's
          dek is the note beside it ("Résumé on request.") */}
      <p class="contact">
        <span class="mail" data-user={site.email.user} data-domain={site.email.domain}>{site.email.user} (at) {site.email.domain.replace(".", " (dot) ")}</span>
        <a href={site.sameAs[0]} rel="me">GitHub <span aria-hidden="true">↗</span></a>
        {about?.dek && <span class="contact-note">{about.dek}</span>}
      </p>
    </div>
  </div>
  <Footer class="foot" links={false} />
</section>

<Fragment slot="scripts">
  <InlineScript src={gridSrc} name="grid.ts" />
  <InlineScript src={carouselSrc} name="carousel.ts" />
  <InlineScript src={recedeSrc} name="recede.ts" />
  <InlineScript src={snapSrc} name="snap.ts" />
</Fragment>
</Base>
